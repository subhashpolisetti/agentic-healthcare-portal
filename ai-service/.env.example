# ChromaDB Cloud (same as backend .env)
CHROMA_TENANT=your-tenant-name
CHROMA_DATABASE=patient-doctor
CHROMA_API_KEY=your-chroma-api-key
COLLECTION_NAME=doctors_nppes
PATIENT_COLLECTION_NAME=patient_cases

# Groq LLM (free tier — https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# CORS (Spring Boot + frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
